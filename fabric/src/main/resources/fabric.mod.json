{
  "schemaVersion": 1,
  "id": "plushables",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "<rainbow>${description}",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "BumbleSculpts",
    "Luke",
    "ChrysanthCow",
    "Steam 'n' Rails Team",
    "Sammy",
    "hibi",
    "Joosh",
    "Omasumi",
    "wiiv"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "icon": "plushables_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.khazoda.plushables.PlushablesFabric"
    ],
    "client": [
      "com.khazoda.plushables.PlushablesFabricClient"
    ],
    "fabric-datagen": [
      "com.khazoda.plushables.datagen.PlushablesDataGenerator"
    ]
  },
  "mixins": [
    "plushables.mixins.json",
    "plushables.fabric.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.com/invite/vEZUkSxwR9"
      }
    }
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_minimum_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
  